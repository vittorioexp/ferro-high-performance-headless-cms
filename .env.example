FERRO_DATABASE_URL=postgres://ferro:ferro@localhost:5432/ferro
# at least 32 random characters, e.g. `openssl rand -hex 32`
FERRO_SECRET=change-me-change-me-change-me-change-me
FERRO_ENV=local
FERRO_BIND=0.0.0.0:8055
FERRO_STORAGE_LOCAL_ROOT=./uploads
FERRO_ADMIN_EMAIL=admin@example.com
FERRO_ADMIN_PASSWORD=change-me-please
FERRO_CORS_ORIGINS=http://localhost:3000
FERRO_ADMIN_DIR=./admin
FERRO_EXTENSIONS_DIR=./examples/site/extensions
# secrets for flows, used as {{ $env.PUBLISH_HOOK_TOKEN }}
FERRO_FLOW_ENV_PUBLISH_HOOK_TOKEN=change-me
FERRO_LOG=info
